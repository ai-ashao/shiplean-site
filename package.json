{
  "name": "shiplean-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "biome check src tests scripts AGENTS.md README.md package.json tsconfig.json vite.config.ts biome.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e-smoke.mjs",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm typecheck && pnpm e2e"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@tanstack/react-router": "1.170.20",
    "@tanstack/react-start": "1.168.37",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@cloudflare/vite-plugin": "1.50.0",
    "@types/node": "24.2.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "typescript": "5.9.2",
    "vite": "7.1.2",
    "vitest": "3.2.4",
    "wrangler": "4.118.0"
  }
}
